# Virtual environment
.venv/

# Python
__pycache__/
*.pyc
*.egg-info/

# Frontend production build (Entry 26) -- generated by `npm run build`,
# not source; the devpilot CLI serves it but doesn't require it be committed
frontend/dist/

# VS Code extension build output (Entry 27) -- node_modules/dist, not source
vscode-extension/node_modules/
vscode-extension/dist/
vscode-extension/*.vsix

# Generated/mutable local state -- not source, regenerated on first run
mcp_servers/database/devpilot_demo.db
mcp_client/memory/project_memory.json

# Persistent chat history (Entry 33) -- real user conversation data,
# scoped per project, not something to commit into DevPilot's own repo
conversation_history/

# Append-only tool-invocation audit log (Entry 41) -- same reasoning as
# conversation_history/: real per-project runtime data, not source
audit_log/

# Secrets -- never commit these, even if one shows up locally later
.env
*.env

# pytest cache (Entry 41)
.pytest_cache/

# Generated fine-tune dataset output (Entry 47) -- regenerated by
# ml/data/*.py, changes every run (and will contain real teacher-API
# output once a key is configured); not source
ml/data/out/

# Generated eval reports (Phase 3) -- regenerated by ml/eval/run_eval.py,
# and most are throwaway (re-run constantly while debugging). Exception:
# the real reports backing numbers actually cited in this project's docs
# (README.md, DevPilot_AI_Learning_Log.md) are committed on purpose,
# small (~11KB each) and not weights -- so a claimed number is
# independently checkable, not just asserted. See README.md's Quickstart
# for which reports these are and the exact command that reproduces them.
ml/eval/out/*
!ml/eval/out/ollama_report.json
!ml/eval/out/finetuned_ollama_report.json
!ml/eval/out/base1.5b_ollama_report.json

# Trained adapters -- real model weights, not source; too large/binary
# for git. Not pushed anywhere else either (an earlier version of this
# comment said "saves them to HF Hub instead" -- that was never actually
# done; the real adapter backing the numbers above was retrieved from
# Kaggle via a local zip extraction, see DevPilot_AI_Learning_Log.md's
# 2026-08-29 entries). Reproduce with: python -m ml.train.train_qlora
# --train ml/data/out/train.jsonl --eval ml/data/out/test.jsonl (needs a
# GPU) -- see README.md's Quickstart.
ml/train/out/
